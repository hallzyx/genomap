# Copy this file to .env in the project root. Keep .env private.
# Local defaults: listen on loopback and do not connect to Stellar.
GENOMAP_HOST=127.0.0.1
GENOMAP_PORT=4173
GENOMAP_STELLAR_NETWORK=standalone

# Set a persistent secret to keep sessions valid across restarts.
# GENOMAP_AUTH_SECRET=

# For an HTTPS reverse proxy, set its exact public origin (no trailing slash)
# and a random auth secret of at least 32 characters. Change GENOMAP_HOST
# above to 0.0.0.0 only if the proxy needs to connect from outside loopback.
# GENOMAP_PUBLIC_ORIGIN=https://genomap.example.com

# Optional SQLite path for standalone. Leave it unset for Testnet.
# GENOMAP_DB_PATH=.pilot-data/genomap.sqlite

# For Testnet, change GENOMAP_STELLAR_NETWORK to testnet and set both values.
# The authorized publisher must already be available in the server user's Stellar CLI.
# GENOMAP_STELLAR_CONTRACT_ID=
# GENOMAP_STELLAR_ISSUER_ALIAS=deployer2
